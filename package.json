{
  "name": "discord-kudos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "plan": "alchemy plan --stage prod",
    "deploy": "alchemy deploy --stage prod --yes && pnpm run register",
    "register": "node scripts/register.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.74",
    "discord-api-types": "^0.38.57",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@cloudflare/workers-types": "4.20260426.1",
    "@types/node": "25.6.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.78.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
