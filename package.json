{
  "name": "discord-kudos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "plan": "alchemy plan --stage prod",
    "deploy": "alchemy deploy --stage prod --yes && pnpm run register",
    "register": "node scripts/register.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "alchemy": "2.0.0-beta.83",
    "discord-api-types": "^0.38.57",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
